---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INVEST_TOPICS } from '../../lib/site';

const posts = await getCollection(
  'posts',
  ({ data }) => !data.draft && data.category === 'invest'
);
const countBy = (slug: string) => posts.filter((p) => p.data.topic === slug).length;
---

<BaseLayout title="投資" description="投資主題分類：戰情室、能源、AI 與機器人、黃金、台股 IPO、顯示驅動、AI 眼鏡與研究筆記。">
  <section class="hero">
    <div class="kicker">分類</div>
    <h1>投資</h1>
    <p>依主題整理的研究與追蹤紀錄。全部為個人學習筆記，<strong>不構成任何投資建議</strong>。</p>
  </section>

  <section>
    <div class="section-head">
      <h2>主題</h2>
      <span class="more">{posts.length} 篇</span>
    </div>
    <ul class="post-list">
      {INVEST_TOPICS.map((t) => (
        <li class="post-item">
          <div class="post-meta">
            <span class="cat cat-invest">投資</span>
            <span>{countBy(t.slug)} 篇</span>
          </div>
          <h3><a href={`/invest/${t.slug}/`}>{t.label}</a></h3>
          <p>{t.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <div class="section-head">
      <h2>語料分佈</h2>
      <span class="more">每日自動產生</span>
    </div>
    <figure class="chart">
      <img src="/charts/blog-content-mix.png" alt="語料主題分佈：各主題文章篇數與佔比" loading="lazy" />
      <figcaption>
        主題分佈 — 研究筆記佔絕大多數，其餘為每日追蹤主題（戰情室、黃金、能源、AI）。
      </figcaption>
    </figure>
    <figure class="chart">
      <img src="/charts/blog-timeline.png" alt="語料時間軸：每月新增文章篇數" loading="lazy" />
      <figcaption>時間軸 — 依 wiki 語料的日期分佈，呈現追蹤密度隨時間的變化。</figcaption>
    </figure>
  </section>
</BaseLayout>

<style>
  .chart {
    margin: 1.25rem 0 2rem;
  }
  .chart img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 10px;
    background: #fff;
  }
  .chart figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted, #6b6b6b);
  }
</style>
