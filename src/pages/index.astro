---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import IpoTicker from '../components/IpoTicker.astro';
import { SITE, CATEGORIES, INVEST_TOPICS } from '../lib/site';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recent = posts.slice(0, 8);
const byCat = (slug: string) => posts.filter((p) => p.data.category === slug).length;
const byTopic = (slug: string) =>
  posts.filter((p) => p.data.category === 'invest' && p.data.topic === slug).length;
---

<BaseLayout>
  <!-- 施工中浮水印：固定覆蓋整頁、不吃滑鼠事件（pointer-events:none） -->
  <div class="wm" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern
          id="wm-pattern"
          width="600"
          height="340"
          patternUnits="userSpaceOnUse"
          patternTransform="rotate(-28)"
        >
          <text
            x="0"
            y="190"
            font-size="150"
            font-weight="900"
            fill="currentColor"
            font-family="-apple-system, 'PingFang TC', 'Microsoft JhengHei', sans-serif">施工中</text
          >
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#wm-pattern)"></rect>
    </svg>
  </div>

  <IpoTicker />

  <section class="hero">
    <div class="construction">🚧 施工中</div>
    <div class="kicker">{SITE.author} · notes</div>
    <h1>技術與投資的學習筆記</h1>
    <p>{SITE.description}</p>
  </section>

  <section>
    <div class="section-head">
      <h2>最新文章</h2>
    </div>
    <ul class="post-list">
      {recent.length > 0 ? recent.map((p) => <PostCard post={p} />) : <li class="empty">尚無文章。</li>}
    </ul>
  </section>

  <section style="margin-top:3rem">
    <div class="section-head"><h2>分類</h2></div>
    <ul class="post-list">
      {CATEGORIES.map((c) => (
        <li class="post-item">
          <div class="post-meta"><span class={`cat cat-${c.slug}`}>{c.label}</span><span>{byCat(c.slug)} 篇</span></div>
          <h3><a href={`/${c.slug}/`}>{c.label}文章</a></h3>
          <p>{c.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  <section style="margin-top:3rem">
    <div class="section-head">
      <h2>投資主題</h2>
      <a class="more" href="/invest/">全部主題 →</a>
    </div>
    <ul class="post-list">
      {INVEST_TOPICS.map((t) => (
        <li class="post-item">
          <div class="post-meta"><span class="cat cat-invest">投資</span><span>{byTopic(t.slug)} 篇</span></div>
          <h3><a href={`/invest/${t.slug}/`}>{t.label}</a></h3>
          <p>{t.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  <style>
    /* ── 施工中水印（首頁）────────────────── */
    .wm {
      position: fixed;
      inset: 0;
      z-index: 9999;
      pointer-events: none;
      color: var(--fg);
      opacity: 0.12;
      overflow: hidden;
    }
    .wm svg { display: block; width: 100%; height: 100%; }
    :global(html[data-theme='dark']) .wm { color: #ffffff; opacity: 0.10; }

    .construction {
      font-size: clamp(2.75rem, 12vw, 7rem);
      font-weight: 900;
      line-height: 1;
      letter-spacing: 0.1em;
      color: #e8590c;
      margin: 0 0 0.9rem;
    }
    :global(html[data-theme='dark']) .construction { color: #ff922b; }
  </style>
</BaseLayout>
