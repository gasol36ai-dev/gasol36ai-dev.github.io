---
import { SITE, CATEGORIES } from '../lib/site';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{SITE.author}<span class="dot">.</span>notes</a>
    <nav class="nav" aria-label="主選單">
      <a href="/" aria-current={isActive('/') ? 'page' : undefined}>首頁</a>
      {CATEGORIES.map((c) => (
        <a href={`/${c.slug}/`} aria-current={isActive(`/${c.slug}/`) ? 'page' : undefined}>
          {c.label}
        </a>
      ))}
      <a href="/about/" aria-current={isActive('/about/') ? 'page' : undefined}>關於</a>
      <button class="theme-btn" id="theme-toggle" type="button" aria-label="切換深色模式">◐</button>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* ignore */
    }
  });
</script>
